{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SelfStoragePRN222;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Issuer": "SelfStorageSystem",
    "Audience": "SelfStorageSystem.Api",
    "Secret": "YOUR_SUPER_SECRET_KEY_MINIMUM_32_CHARACTERS_HERE",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000",
      "http://localhost:5174"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GoogleAuthSettings": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "MailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 465,
    "SenderEmail": "YOUR_EMAIL@gmail.com",
    "SenderName": "Self Storage System",
    "Username": "YOUR_EMAIL@gmail.com",
    "Password": "YOUR_GMAIL_16_DIGIT_APP_PASSWORD",
    "EnableSsl": true
  },
  "OtpSettings": {
    "ExpirationMinutes": 10,
    "CodeLength": 6,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5,
    "MaxRequestsPerHour": 5,
    "LockoutMinutes": 15
  },
  "RateLimitingSettings": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "ReservationSettings": {
    "HoldDurationMinutes": 15,
    "HoldGracePeriodMinutes": 3,
    "MinDurationMonths": 1,
    "MaxDurationMonths": 12,
    "ExpiryCheckIntervalSeconds": 30
  },
  "PaymentSettings": {
    "VietQr": {
      "BaseUrl": "https://vietqr.app/img",
      "BankCode": "YOUR_BANK_CODE",
      "AccountNo": "YOUR_BANK_ACCOUNT_NO",
      "AccountName": "YOUR_ACCOUNT_NAME",
      "Template": "compact",
      "ShowInfo": true
    },
    "SePay": {
      "ApiKey": "YOUR_SEPAY_API_KEY",
      "InvoicePrefix": "DH"
    }
  },
  "AllowedHosts": "*"
}
