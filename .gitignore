# Visual Studio Code & IDEs
.vscode/
.vs/
.idea/

# Environment & Secrets files
.env
.env.local
*.env
*.secrets.json
appsettings*.json
appsettings.json

# Frontend folder (managed in a separate repo)
FE/
fe/

# OS generated files
.DS_Store
Thumbs.db

# Backup bundles
*.bundle
